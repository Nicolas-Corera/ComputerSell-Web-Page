# ===== Tokens de acceso (solo para scripts locales, nunca se envian al navegador) =====
GITHUB=
SUPABASE=
#VERCEL=

# ===== Proyecto Supabase (publicos: van al navegador via assets/js/core/env.js) =====
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=            # solo scripts (npm run firma); nunca va al navegador

# ===== Panel: solo estos correos pueden crear cuenta de administrador =====
# Separados por coma. Aplicar cambios con: npm run admins:sync
ADMIN_EMAILS=admin@computersell.com.ar

# ===== Datos privados del vendedor (nota de venta y cuenta para transferencias) =====
# No van en archivos públicos: se cargan en private.seller_info con `npm run seller:sync`
# y el sitio los lee con el RPC seller_private() solo con sesión iniciada.
SELLER_OWNER=                    # nombre completo (aparece como "Vendedor" en la nota de venta)
SELLER_DOC=                      # ej. CUIT 20-12345678-9
BANK_HOLDER=                     # titular de la cuenta (si falta, se usa SELLER_OWNER)
BANK_CBU=
BANK_ALIAS=
BANK_CUIL=

# ===== Auth =====
SITE_URL=http://localhost:3000
# El panel vive en dash.<dominio>: agregar también http://dash.localhost:3000 y https://dash.<dominio>
EXTRA_REDIRECT_URLS=http://dash.localhost:3000
MAILER_AUTOCONFIRM=false          # true = sin confirmar el correo (solo para desarrollar sin SMTP; inseguro)

# ===== Correos de Auth por Resend (SMTP) =====
# Sin esto Supabase solo manda correos a los miembros del equipo (2 por hora):
# los clientes no reciben "olvidé mi contraseña" ni la confirmación de cuenta.
# RESEND_FROM tiene que ser de un dominio verificado en Resend -> Domains.
# Aplicar con: npm run auth:configure
RESEND=                          # API key de Resend (re_...)
RESEND_FROM=                     # ej. no-reply@computersell.com.ar
RESEND_SENDER_NAME=ComputerSell
# Formulario de contacto y avisos de pedidos (api/contact, api/orders/*) usan la misma API key.
CONTACT_TO=contacto@computersell.com.ar   # consultas del formulario y reply-to de los mails al cliente
NOTIFY_ADMIN_TO=ventas@computersell.com.ar # avisos de ventas y comprobantes
CONTACT_DAILY_LIMIT=40           # tope diario de consultas (cada una manda 2 correos)
NOTIFY_HOOK_SECRET=              # clave de /api/notify-mail (la misma que private.mail_hook.secret en la base)

# ===== Google OAuth (Google Cloud Console -> Credenciales -> ID de cliente OAuth 2.0) =====
# URI de redireccion autorizada: https://<project-ref>.supabase.co/auth/v1/callback
# Despues de cargarlos: npm run auth:configure
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Mercado Pago (Checkout API / Orders) =====
# Tus integraciones -> aplicación -> Credenciales. Para probar: credenciales
# de PRODUCCIÓN de un usuario de prueba (vendedor); las TEST- no sirven con Orders.
PUBLIC_KEY=                      # pública: va al navegador vía env.js (SDK, tokeniza la tarjeta)
ACCESS_TOKEN=                    # secreta: solo la usa api/mp/* (Vercel Functions)
# Webhooks -> Configurar notificaciones -> evento "Order" -> URL https://<dominio>/api/mp/webhook
CLAVE_WEBHOOK=                   # clave secreta que genera Mercado Pago al guardar el webhook
